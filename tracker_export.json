      {
        "id": "f474acb9-3132-438f-803c-5a3f649cf72e",
        "name": "Sanitize Outcome",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1230,
          300
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const t = $input.first().json;\nconst st = t.status || ((t.patch&&t.patch.status)||'?');\nconst ex = (t.exit_price!==undefined&&t.exit_price!==0)?t.exit_price:((t.patch&&t.patch.exit_price)||'?');\nconst rr = (t.outcome_R!==undefined&&!(t.outcome_R===0&&st==='OPEN'))?t.outcome_R:((t.patch&&t.patch.outcome_R)||'?');\nlet s = 'نتيجه سيگنال ' + (t.symbol||'?') + ' ← ' + st + ' | خروج: ' + ex + ' | R: ' + rr;\ns = s.replace(/[\\u0000-\\u001F\\u007F-\\u009F]/g, ' ').trim().slice(0,1000);\nreturn [{ json: { chat_id: '6643216800', text: s } }];"
        }
