      {
        "id": "79e9f45a-024c-484d-a920-2117c43a0494",
        "name": "Ledger Get OPEN",
        "type": "n8n-nodes-base.dataTable",
        "typeVersion": 1.1,
        "position": [
          680,
          300
        ],
        "parameters": {
          "resource": "row",
          "operation": "get",
          "dataTableId": {
            "__rl": true,
            "mode": "id",
            "value": "eOctngGT0qLnzQ54"
          },
